   "version": "0.2.0",
   "inputs": [
      {
         "id": "percist_folder",
         "type": "command",
         "command": "cmake.cacheVariable",
         "args": {"name": "LANGULUS_PERCIST_DIRECTORY"}
      }
   ],
   "configurations": [
      {
         "name": "LangulusPercist",
         "type": "lldb",
         "request": "launch",
         "program": "${command:cmake.launchTargetDirectory}/LangulusPercist.exe",
         "args": [
            "-f", "./consumption.txt",
            "-c", "${input:percist_folder}/consumption.canon"
         ],
         "cwd": "${command:cmake.buildDirectory}/bin"
      },
      {
         "name": "LangulusAnynessTest-Common",
